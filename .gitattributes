# Текст — с переводами строк, нормализованными в индексе, независимо от
# настроек git у того, кто коммитит.
* text=auto

# Эталоны платформы хранятся байт в байт: вся их ценность в том, что их написал
# конфигуратор, а не мы. При `core.autocrlf=true` git свернул бы им CRLF в LF
# в индексе — и сверка сравнивала бы уже не то, что выдала платформа.
# Две звёздочки — вместе с подкаталогами: эталоны форм лежат глубже, и с одной
# звёздочкой они попали бы в индекс с LF.
meta/tests/эталоны/** -text

# Исходники проекта — обычный текст, переводы строк нормализуются как везде.
*.py text
*.md text
*.toml text
